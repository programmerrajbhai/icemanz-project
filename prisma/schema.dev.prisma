generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Category {
  id            String     @id @default(uuid())
  name          String
  slug          String     @unique
  parentId      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  parent        Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subcategories Category[] @relation("CategoryToCategory")
  products      Product[]
}

model Product {
  id               String    @id @default(uuid())
  title            String
  slug             String    @unique
  brand            String?
  sku              String?
  badge            String?
  description      String?
  keyFeatures      String?
  condition        String?
  type             String?
  price            String?
  images           String    // SQLite doesn't support arrays, stored as JSON string
  warranty         String    // Stored as JSON string
  detailedFeatures String    // Stored as JSON string
  specs            String?   // Stored as JSON string
  documents        String?   // Stored as JSON string
  faqs             String?   // Stored as JSON string
  productOptions   String?   // Stored as JSON string
  features         String?   // Stored as JSON string
  categoryId       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  category         Category? @relation(fields: [categoryId], references: [id])
}

model InvoiceRequest {
  id                 String   @id @default(uuid())
  email              String
  phone              String?
  status             String   @default("PENDING")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  address            String?
  customTemp         String?
  description        String?
  fullName           String
  height             String?
  length             String?
  products           String?  // Stored as JSON string
  projectName        String?
  quantity           String?
  tempRange          String?
  width              String?
  stripeCheckoutUrl  String?
  stripeSessionId    String?
  totalAmount        Float?
  order              Order?
  additionalWarranty Int?     @default(0) // Boolean as 0/1
  deliveryTime       String?
  offerDiscount      Float?
  tax                Float?
  deliveryCost       Float?
  totalWithTax       Float?
  deliveryNotes      String?
  category           String?
}

model Order {
  id              String         @id @default(uuid())
  invoiceId       String         @unique
  customerName    String
  customerEmail   String
  amountPaid      Float
  currency        String         @default("usd")
  stripeSessionId String         @unique
  stripePaymentId String?
  status          String         @default("PAID")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  invoice         InvoiceRequest @relation(fields: [invoiceId], references: [id])
  category        String?
}

model CustomQuoteRequest {
  id                  String   @id @default(uuid())
  date                String?
  jobName             String
  address             String
  fullName            String?
  email               String?
  phone               String?
  ambientTemp         String?
  voltage             String?
  phase               String?
  coolerSystemType    String?
  coolerRequiredTemp  String?
  coolerDimension     String?
  coolerNoOfDoors     String?
  coolerDoorSize      String?
  freezerSystemType   String?
  freezerRequiredTemp String?
  freezerDimension    String?
  freezerNoOfDoors    String?
  freezerDoorSize     String?
  additionalInfo      String?
  status              String   @default("PENDING")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model GeneralEnquiry {
  id        String   @id @default(uuid())
  fullName  String
  email     String
  phone     String
  message   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

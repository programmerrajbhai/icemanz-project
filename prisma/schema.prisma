generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id            String     @id @default(uuid())
  name          String
  slug          String     @unique
  parentId      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  parent        Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  subcategories Category[] @relation("CategoryToCategory")
  products      Product[]
}

model Product {
  id               String    @id @default(uuid())
  title            String
  slug             String    @unique
  badge            String?
  description      String?
  keyFeatures      String?
  condition        String?
  type             String?
  price            String?
  images           String[]
  warranty         String[]
  detailedFeatures String[]
  specs            Json?
  documents        Json?
  categoryId       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  category         Category? @relation(fields: [categoryId], references: [id])
}

model InvoiceRequest {
  id              String   @id @default(uuid())
  email           String
  phone           String?
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  address         String?
  customTemp      String?
  description     String?
  fullName        String
  height          String?
  length          String?
  products        Json?
  projectName     String?
  quantity        String?
  tempRange       String?
  width           String?
  paymentLink     String?
  stripeSessionId String?
  totalAmount     Float?
  order           Order?
}

model Order {
  id              String         @id @default(uuid())
  invoiceId       String         @unique
  customerName    String
  customerEmail   String
  amountPaid      Float
  currency        String         @default("usd")
  stripeSessionId String         @unique
  stripePaymentId String?
  status          String         @default("PAID")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  invoice         InvoiceRequest @relation(fields: [invoiceId], references: [id])
}

model CustomQuoteRequest {
  id                  String   @id @default(uuid())
  date                String?
  jobName             String
  address             String
  ambientTemp         String?
  voltage             String?
  phase               String?
  coolerSystemType    String?
  coolerRequiredTemp  String?
  coolerDimension     String?
  coolerNoOfDoors     String?
  coolerDoorSize      String?
  freezerSystemType   String?
  freezerRequiredTemp String?
  freezerDimension    String?
  freezerNoOfDoors    String?
  freezerDoorSize     String?
  additionalInfo      String?
  status              String   @default("PENDING")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model GeneralEnquiry {
  id        String   @id @default(uuid())
  fullName  String
  email     String
  phone     String
  message   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

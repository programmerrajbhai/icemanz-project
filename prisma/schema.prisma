generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}





model Category {
  id            String     @id @default(uuid())
  name          String
  slug          String     @unique
  parentId      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  parent        Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  subcategories Category[] @relation("CategoryToCategory")
  products      Product[]
}




model Brand {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id               String    @id @default(uuid())
  title            String
  slug             String    @unique
  brand            String?
  brandId          String?
  sku              String?
  badge            String?
  description      String?     // <-- Updated for long text
  keyFeatures      String?   // <-- Updated for long text
  condition        String?
  type             String?
  price            String?
  images           Json?
  warranty         Json?
  detailedFeatures Json?
  specs            Json?
  documents        Json?
  faqs             Json?
  productOptions   Json?
  features         Json?
  layouts          Json?     
  categoryId       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  category         Category? @relation(fields: [categoryId], references: [id])
  brandRef         Brand?    @relation(fields: [brandId], references: [id])
}



model InvoiceRequest {
  id                 String    @id @default(uuid())
  email              String
  phone              String?
  status             String    @default("PENDING")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  address            String?
  customTemp         String?
  description        String?
  fullName           String
  height             String?
  length             String?
  products           Json?
  projectName        String?
  quantity           String?
  tempRange          String?
  width              String?
  stripeCheckoutUrl  String?  
  stripeSessionId    String?  
  totalAmount        Float?
  order              Order?
  additionalWarranty Boolean?  @default(false)
  deliveryTime       String?
  offerDiscount      Float?
  tax                Float?
  deliveryCost       Float?
  totalWithTax       Float?
  deliveryNotes      String?
  category           String? 
}

model Order {
  id              String         @id @default(uuid())
  invoiceId       String         @unique
  customerName    String
  customerEmail   String
  customerPhone   String?        
  amountPaid      Float
  currency        String         @default("usd")
  stripeSessionId String         @unique
  stripePaymentId String?
  status          String         @default("PAID")
  shippingName    String?
  shippingAddress String?
  shippingCity    String?
  shippingState   String?
  shippingZip     String?
  shippingCountry String?
  deliveryMethod  String?        
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  invoice         InvoiceRequest @relation(fields: [invoiceId], references: [id])
  category        String? 
}

model CustomQuoteRequest {
  id                  String   @id @default(uuid())
  date                String?
  jobName             String
  address             String
  fullName            String?
  email               String?
  phone               String?
  ambientTemp         String?
  voltage             String?
  phase               String?
  coolerSystemType    String?
  coolerRequiredTemp  String?
  coolerDimension     String?
  coolerNoOfDoors     String?
  coolerDoorSize      String?
  freezerSystemType   String?
  freezerRequiredTemp String?
  freezerDimension    String?
  freezerNoOfDoors    String?
  freezerDoorSize     String?
  additionalInfo      String?
  status              String   @default("PENDING")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model GeneralEnquiry {
  id        String   @id @default(uuid())
  fullName  String
  email     String
  phone     String
  message   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}